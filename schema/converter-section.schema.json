{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/libviprs/pvec-gold-fixtures/schema/converter-section.schema.json",
  "title": "converter section of comparison.json",
  "description": "The classification of the primary converter's signature against the secondary's. Where expected.math.json exists the verdict against it governs. Agreement is DUAL_ORACLE_EQUIVALENT evidence and never source truth. A MATERIAL_DIFFERENCE carries a quarantine record with a named reason.",
  "type": "object",
  "required": ["schema_version", "class", "governing", "truth", "deciding", "statement", "evidence", "quarantine", "converters", "signatures", "numeric_policy_version", "signature_schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "pvec-gold/converter-section/1"},
    "class": {"enum": ["MATCH", "EXACT_REPARAMETERIZATION", "EQUIVALENT_GEOMETRY", "MATERIAL_DIFFERENCE"]},
    "governing": {"enum": ["KNOWN_TRUTH", "SIGNATURE_COMPARISON"]},
    "truth": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["primary", "secondary"], "additionalProperties": false,
              "properties": {"primary": {"$ref": "#/$defs/truth"}, "secondary": {"$ref": "#/$defs/truth"}}}]},
    "deciding": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["field", "deviation", "unit", "at_unit_parameter"],
              "properties": {"field": {"type": "string", "minLength": 1}, "deviation": {"type": "number"}, "unit": {"type": "string"},
                             "at_unit_parameter": {"type": "number"}, "converter": {"enum": ["primary", "secondary"]}}}]},
    "statement": {"type": "string", "minLength": 1},
    "evidence": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["class", "is_source_truth", "evidence_scope", "oracle_scope"], "additionalProperties": false,
              "properties": {"class": {"const": "DUAL_ORACLE_EQUIVALENT"}, "is_source_truth": {"const": false},
                             "evidence_scope": {"const": "STEP_ORACLE"}, "oracle_scope": {"enum": ["OPEN_CONVERTERS", "VENDOR_CONVERTERS"]}}}]},
    "quarantine": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["state", "reason", "detail"], "additionalProperties": false,
              "properties": {"state": {"const": "QUARANTINED"},
                             "reason": {"enum": ["UNRESOLVED_DISAGREEMENT", "UNSUPPORTED_ENTITY", "APPROXIMATION"]},
                             "detail": {"type": "string", "minLength": 1}}}]},
    "converters": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["id", "version", "lineage", "image_digest"], "additionalProperties": false,
              "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "lineage": {"type": "string"}, "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "signatures": {"type": "object", "required": ["primary_sha256", "secondary_sha256"], "additionalProperties": false,
                   "properties": {"primary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "secondary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "numeric_policy_version": {"type": "string", "minLength": 1},
    "signature_schema_version": {"const": "pvec-gold/signature/1"}
  },
  "$defs": {"truth": {"enum": ["STRUCTURAL_EXACT", "GEOMETRIC_EXACT_REPARAMETERIZED", "BOUNDED_APPROXIMATION", "UNSUPPORTED", "MISSING"]}}
}
