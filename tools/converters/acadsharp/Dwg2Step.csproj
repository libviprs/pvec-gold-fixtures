<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Dwg2Step</AssemblyName>
    <RootNamespace>Dwg2Step</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Where upstream ACadSharp's src/ is checked out; the Dockerfile clones the pinned commit there. -->
    <AcsSrc Condition="'$(AcsSrc)' == ''">/opt/acadsharp/src</AcsSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AcsSrc)/ACadSharp/ACadSharp.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
